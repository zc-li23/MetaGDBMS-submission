use std::sync::Arc;

use {{IMPL_CRATE}}::{
    CsrProjection, MetagdbExecutor, MetagdbImpl, MetagdbOptimizer, MetagdbParser,
    MetagdbPlanner,
};

use crate::pipeline::{Runtime, RuntimeBuilder};
use metagdb_core::l5_interaction::{LanguageFrontend, QueryLanguage};
use metagdb_core::Result;

/// Build the language-independent component package used by the fixed system
/// benchmark.  Reopening is performed by calling this function again with the
/// same directory, so persistence is tested through the public constructor.
pub fn build_benchmark_components(
    base_dir: &std::path::Path,
) -> metagdb_core::benchmark::BenchmarkComponents {
    let impl_ = MetagdbImpl::with_base_dir(base_dir.to_path_buf());
    benchmark_components_from_impl(impl_)
}

/// Import a `.graph` file and expose the resulting components to the fixed
/// performance runner. Dataset preparation is timed separately from queries.
pub fn build_benchmark_components_from_graph_file(
    graph_file: &std::path::Path,
    base_dir: &std::path::Path,
) -> Result<metagdb_core::benchmark::BenchmarkComponents> {
    let impl_ = MetagdbImpl::build_from_graph_file(
        graph_file.to_path_buf(),
        base_dir.to_path_buf(),
    )?;
    Ok(benchmark_components_from_impl(impl_))
}

fn benchmark_components_from_impl(
    impl_: MetagdbImpl,
) -> metagdb_core::benchmark::BenchmarkComponents {
    metagdb_core::benchmark::BenchmarkComponents {
        schema: impl_.schema,
        storage: impl_.storage,
        txn_manager: impl_.txn_manager,
        algorithms: impl_.algorithms,
        projection_factory: Arc::new(|storage, txn, spec| {
            Ok(Box::new(CsrProjection::build(storage, txn, spec)?))
        }),
    }
}

/**
 * @brief: Based on the provided implementation handle, assemble and return a complete query runtime container.
 *
 * Frontend is uniformly provided by the framework layer (GenericFrontend), no longer obtained from the impl crate.
 *
 * @param impl_: The MetagdbImpl object provided by the currently active implementation crate.
 * @return: Returns a Runtime instance on success, otherwise returns an Error.
 */
pub fn build_runtime(impl_: &MetagdbImpl) -> Result<Runtime> {
    let mut builder = RuntimeBuilder::new()
        .with_schema(impl_.schema.clone())
        .with_storage(impl_.storage.clone())
        .with_txn_manager(impl_.txn_manager.clone())
        .with_parser(QueryLanguage::{{QUERY_LANGUAGE_VARIANT}}, Box::new(MetagdbParser))
        .with_planner(Box::new(MetagdbPlanner))
        .with_optimizer(Box::new(MetagdbOptimizer))
        .with_executor(Box::new(MetagdbExecutor))
        .with_frontend(Arc::new(LanguageFrontend::new(QueryLanguage::{{QUERY_LANGUAGE_VARIANT}})))
        .with_default_language(QueryLanguage::{{QUERY_LANGUAGE_VARIANT}});

    for algo in &impl_.algorithms {
        builder = builder.register_algorithm(algo.clone());
    }

    builder.build()
}

/**
 * @brief: End-to-end Demo test entry point: directly delegates to the impl crate's demo_test().
 *
 * demo_test() is provided by the impl crate (LLM-generated or hand-written), zero parameters, internally self-contained:
 *   Create Runtime -> Insert demo data -> Execute test queries one by one -> Verify output -> Print results.
 * The framework's main.rs executes the demo through this function, thus not needing to be aware of any query language details.
 *
 * @return: Returns Ok(()) on success, otherwise returns an Error.
 */
pub fn run_demo_test() -> Result<()> {
    MetagdbImpl::demo_test()
}

/**
 * @brief: Batch build database from .graph file and return Runtime.
 *
 * Used for cargo run -- --build xxx.graph batch import mode.
 * Data is persisted to the base_dir directory.
 *
 * @param graph_file: Path to the .graph file.
 * @param base_dir: Path to the directory for storing database files.
 * @return: Returns a Runtime instance on success, otherwise returns an Error.
 */
pub fn build_from_graph_file(graph_file: &std::path::Path, base_dir: &str) -> Result<Runtime> {
    let impl_ = MetagdbImpl::build_from_graph_file(
        graph_file.to_path_buf(),
        std::path::PathBuf::from(base_dir),
    )?;
    build_runtime(&impl_)
}

/**
 * @brief: Convenience constructor: constructs Runtime using the specified data directory (no preset demo data).
 *
 * Used for REPL interactive mode: data is persisted to the base_dir directory, and previously stored data can be read upon restart.
 * If data files already exist in the directory, they are automatically opened and reused; otherwise, an empty database is created.
 *
 * @param base_dir: Path to the directory for storing data files.
 * @return: Returns a Runtime instance on success, otherwise returns an Error.
 */
pub fn build_runtime_clean(base_dir: &str) -> Result<Runtime> {
    let impl_ = MetagdbImpl::with_base_dir(std::path::PathBuf::from(base_dir));
    build_runtime(&impl_)
}
