# Local agent and editor state
.claude/
.codex/
.cursor/
.env

# Python caches
__pycache__/
*.py[cod]

# Rust build and runtime data
target/
logs/
*.dat
*.interp
*.tokens
*.pest

# Local datasets and experiment corpora; grammar sources remain versioned.
/data/*
!/data/language/
!/data/language/**
!/data/README.md
!/data/raw/
/data/raw/*
!/data/raw/*.graph.gz

# Files regenerated by scripts/build.py when an implementation is activated.
# The root Cargo.lock is derived from that generated manifest plus the selected
# candidate crate, so it records a local implementation choice rather than
# framework source; tracking it forced a re-activation of metagdb_default before
# every framework commit.
/Cargo.toml
/Cargo.lock
/metagdb_src/metagdb/Cargo.toml
/metagdb_src/metagdb/src/assembly/active.rs

# Local design-vector drafts for an experiment in progress. The reusable template
# stays tracked under docs/synthesis/templates/; a promoted experiment commits its
# design vector next to its result.
/design_vector.*.json

# Local implementation selection
/metagdb_src/implementation/manifest.local.toml

# The standalone profile syntax checker builds its own crate
/benchmark/syntax_check/target/
/benchmark/syntax_check/Cargo.lock

# Local reference repositories and research scratch files
external/
plan.md

# Local generated candidates and their activation configs
/metagdb_src/implementation/generated/
/scripts/config/*
!/scripts/config/metagdb_default.toml

# Source-only snapshots of the three evaluated systems.
!/metagdb_src/implementation/generated/
/metagdb_src/implementation/generated/*
!/metagdb_src/implementation/generated/metagdb_exp_lat_01/
!/metagdb_src/implementation/generated/metagdb_exp_thr_02/
!/metagdb_src/implementation/generated/metagdb_exp_alg_01/
/metagdb_src/implementation/generated/metagdb_exp_lat_01/*
/metagdb_src/implementation/generated/metagdb_exp_thr_02/*
/metagdb_src/implementation/generated/metagdb_exp_alg_01/*
!/metagdb_src/implementation/generated/metagdb_exp_lat_01/Cargo.toml
!/metagdb_src/implementation/generated/metagdb_exp_thr_02/Cargo.toml
!/metagdb_src/implementation/generated/metagdb_exp_alg_01/Cargo.toml
!/metagdb_src/implementation/generated/metagdb_exp_lat_01/src/
!/metagdb_src/implementation/generated/metagdb_exp_thr_02/src/
!/metagdb_src/implementation/generated/metagdb_exp_alg_01/src/
!/metagdb_src/implementation/generated/metagdb_exp_lat_01/src/**
!/metagdb_src/implementation/generated/metagdb_exp_thr_02/src/**
!/metagdb_src/implementation/generated/metagdb_exp_alg_01/src/**

# Legacy candidate-local oracle (canonical datasets now live under benchmark/)
/metagdb_src/implementation/oracle/

# Local requirement-to-design runs and their evidence bundles
/design_runs/
# Local per-experiment input copies.
/requirements/

# Exclude local experiment helpers from the review snapshot.
/scripts/experiments/
/metagdb_src/metagdb/examples/
/artifacts/
/benchmark/graded/*
!/benchmark/graded/suite200.jsonl

# Reviewed supplemental material.
!/artifacts/
/artifacts/*
!/artifacts/README.md
!/artifacts/results.md
